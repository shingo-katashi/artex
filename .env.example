# Docker 배포 설정 (.env 로 복사)
# artex 이미지는 compose가 이 저장소 Dockerfile로 빌드합니다 (한국어 UI).
ARTEX_IMAGE_TAG=local
# 이미지 빌드 시 Playwright Chromium 설치 (0=건너뜀, 네트워크 타임아웃 시)
PLAYWRIGHT_WITH_DEPS=1
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (하나 또는 모두; UI에서도 설정 가능)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
